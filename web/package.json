{
  "name": "@ss/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.reading-end.config.ts",
    "audit:reading-end": "node scripts/audit-reading-end-build.mjs",
    "audit:reading-end-fixtures": "node scripts/audit-reading-end-fixtures.mjs",
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:reading-end": "vitest run --config vitest.reading-end.config.ts src/reading-end",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:reading-end": "tsc -p tsconfig.reading-end.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@ss/shared": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "vite": "8.0.16",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "4.1.9"
  }
}
